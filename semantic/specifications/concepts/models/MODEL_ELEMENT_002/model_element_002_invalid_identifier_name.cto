// This file intentionally does not parse: the CTO identifier grammar never
// allows a hyphen (an identifier is a letter/$/_ followed by letters,
// digits, $ or _), so the parser rejects "Invalid-Name" with a
// ParseException before the MODEL_ELEMENT_002 semantic rule is ever
// reached. Reaching that rule needs a hand-authored JSON AST, since no
// valid CTO text produces a declaration name the metamodel itself deems
// invalid. See model_element_002_invalid_identifier_name.json.
namespace org.example.modelelement002.invalid@1.0.0

concept Invalid-Name {
  o String something
}
