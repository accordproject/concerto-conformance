// This file intentionally does not parse: the grammar's Integer range
// validator only accepts signed-integer literals (range=[lower,upper]), so
// a decimal lower bound such as 0.5 is a ParseException, never a semantic
// one. Per the P5-08 promotion plan (FIX-01/X-06), a syntactic negative
// like this belongs in a parser-level suite, not a hand-authored JSON AST
// standing in for CTO text the grammar can never produce -- so this fixture
// has no JSON AST, and the scenario in scalars.feature is left @skip
// pending a maintainer decision on where it belongs (see the P5-08a
// review report).
namespace org.concerto.scalars.valid.num003@1.0.0

concept InvalidInteger {
  o Integer value range=[0.5, 100]
}
